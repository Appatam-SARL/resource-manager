# API — STAGING (Render). Template only: set real values in the Render dashboard, never in Git.
# Dedicated staging database: never point to preprod or production.

NODE_ENV=production
APP_ENV=staging
PORT=3000
# Render terminates TLS in front of the container
TRUST_PROXY_HOPS=1
# Applies "prisma migrate deploy" before start (Render free plan has no pre-deploy command)
RUN_MIGRATIONS=true

DATABASE_URL=postgresql://ressource_manager_stagging_user:TlPl81WJLdh9eOwoUAEOt4eoEwTPe9T8@dpg-davv7hijnfac73d9ecu0-a:5432/ressource-manager-stagging?schema=public

# Exact admin origin(s), comma-separated. Never "*".
CORS_ORIGIN=https://<admin-staging-host>
# WS_ALLOWED_ORIGINS defaults to CORS_ORIGIN

# 32+ random characters each, unique to staging (e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET=<generate>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate>
JWT_REFRESH_EXPIRES_IN=7d

# Optional, only with Expo "Enhanced Push Security"
# EXPO_ACCESS_TOKEN=
