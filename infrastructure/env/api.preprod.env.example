# API — PREPROD (Render). Template only: set real values in the Render dashboard, never in Git.
# Dedicated preprod database and secrets: never reuse staging or production values.
# Production data may only be copied here after anonymisation (see docs/devops/preprod.md).

NODE_ENV=production
APP_ENV=preprod
PORT=3000
TRUST_PROXY_HOPS=1
RUN_MIGRATIONS=true

DATABASE_URL=postgresql://<user>:<password>@<preprod-host>:5432/<preprod-db>?schema=public

# Exact Vercel preprod admin origin. Never "*".
CORS_ORIGIN=https://<admin-preprod-host>

JWT_ACCESS_SECRET=<generate, preprod only>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate, preprod only>
JWT_REFRESH_EXPIRES_IN=7d

# EXPO_ACCESS_TOKEN=
