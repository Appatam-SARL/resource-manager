# Admin — PREPROD (Vercel project dedicated to preprod, "Production" environment of that project).
# Set these in Vercel → Project → Settings → Environment Variables.

APP_ENV=preprod
# Public API base URL, without /api/v1
API_PUBLIC_URL=https://<api-preprod-host>
# GIT_COMMIT_SHA and APP_VERSION are passed by the promotion workflow (fallback: VERCEL_GIT_COMMIT_SHA).
