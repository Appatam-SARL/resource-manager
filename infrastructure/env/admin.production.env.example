# Admin — PRODUCTION (cPanel). Template only.
# Real file: ~/resource-manager/shared/admin.env on the server, chmod 600, outside public_html.
# It contains no secret: everything here ends up visible to the browser.

APP_ENV=production
# Public API base URL, without /api/v1. On cPanel the admin and the API are two Passenger
# applications on two subdomains: the admin is NOT served from the same origin as the API.
API_PUBLIC_URL=https://<api.example.com>

# Not to set here: GIT_COMMIT_SHA, APP_VERSION (read from the release), PORT/HOSTNAME (Passenger).
