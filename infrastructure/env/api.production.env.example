# API — PRODUCTION (cPanel). Template only.
# Real file: ~/resource-manager/shared/api.env on the server, chmod 600, outside public_html,
# created by hand over SSH. Never in Git, never in a GitHub secret, never in staging/preprod.
# The values of this file override those set in the cPanel "Setup Node.js App" interface.

NODE_ENV=production
APP_ENV=production
TRUST_PROXY_HOPS=1

# Local cPanel PostgreSQL (localhost only, port 5432 never exposed to Internet).
# Dedicated production database and user, created in cPanel → PostgreSQL Databases.
# Percent-encode special characters of the password.
DATABASE_URL=postgresql://<cpaneluser_rmprod>:<password>@localhost:5432/<cpaneluser_resource_manager>?schema=public

# Exact admin origin (separate subdomain, HTTPS). Never "*".
CORS_ORIGIN=https://<admin.example.com>
# WS_ALLOWED_ORIGINS defaults to CORS_ORIGIN

# Generate on a trusted machine: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate, production only>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate, production only, different from the access secret>
JWT_REFRESH_EXPIRES_IN=7d

# EXPO_ACCESS_TOKEN=

# Not to set here: GIT_COMMIT_SHA, APP_VERSION, BUILD_DATE (read from the release), PORT (Passenger).
