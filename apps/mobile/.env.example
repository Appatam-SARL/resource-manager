# Leave empty to auto-detect (recommended with Expo):
# - uses the same LAN IP as Metro (e.g. 192.168.x.x:3000)
# - Android emulator fallback: http://10.0.2.2:3000
#
# Or set explicitly:
# Android emulator:  http://10.0.2.2:3000
# iOS simulator:     http://localhost:3000
# Physical device:   http://<IP-LAN-du-PC>:3000
EXPO_PUBLIC_API_URL=
