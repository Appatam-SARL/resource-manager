# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resource_manager?schema=public"

# API
PORT=3000
NODE_ENV=development
# Deployment target: development | test | staging | preprod | production
# (staging and preprod run with NODE_ENV=production)
APP_ENV=development
# Number of reverse proxies in front of the API (0 locally, 1 behind Caddy or Render)
TRUST_PROXY_HOPS=0
# APP_VERSION, GIT_COMMIT_SHA and BUILD_DATE are injected into the Docker image at build time.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# WebSocket (namespace /realtime) — browser origins allowed; defaults to CORS_ORIGIN.
# In production, "*" or empty refuses every browser origin (native mobile is not affected).
# WS_ALLOWED_ORIGINS=http://localhost:3001

# JWT — replace with strong random secrets in real environments (min 32 chars)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Expo Push — optional, only when "Enhanced Push Security" is enabled on the Expo account
# EXPO_ACCESS_TOKEN=

# Password hashing uses Argon2id (no AUTH_BCRYPT_ROUNDS needed)
# Optional Argon2 overrides can be added later if required.
