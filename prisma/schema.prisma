generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GROUP_ADMIN
  COMPANY_ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ResourceStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ResourceType {
  VEHICLE
  ROOM
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
  LOGIN
  LOGOUT
  STATUS_CHANGE
}

enum PushPlatform {
  ANDROID
  IOS
}

enum NotificationType {
  RESERVATION_CREATED
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_EXTENDED
}

/// Root organisation of the internal Group application (not a SaaS tenant).
model Group {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
}

model Company {
  id          String       @id @default(cuid())
  groupId     String
  name        String
  code        String?
  status      EntityStatus @default(ACTIVE)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  directions    Direction[]
  users         User[]
  vehicles      Vehicle[]
  meetingRooms  MeetingRoom[]
  reservations  Reservation[]

  @@index([groupId])
  @@index([status])
  @@unique([groupId, code])
}

/// Optional organisational level under a Company.
model Direction {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  code        String?
  status      EntityStatus @default(ACTIVE)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  reservations Reservation[]

  @@index([companyId])
  @@index([status])
  @@unique([companyId, code])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  status       UserStatus @default(ACTIVE)
  companyId    String
  directionId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  direction     Direction?     @relation(fields: [directionId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  reservations  Reservation[]
  notifications Notification[]
  pushTokens    UserPushToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@index([directionId])
  @@index([status])
  @@index([role])
}

/// Stores only hashed refresh tokens (never the raw token).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Vehicle {
  id                 String         @id @default(cuid())
  companyId          String
  registrationNumber String
  brand              String
  model              String
  seats              Int
  status             ResourceStatus @default(AVAILABLE)
  description        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  image        VehicleImage?

  @@unique([companyId, registrationNumber])
  @@index([companyId])
  @@index([status])
}

/// Optional vehicle photo, kept apart from Vehicle so lists never load the bytes.
model VehicleImage {
  vehicleId String   @id
  data      Bytes
  mimeType  String
  size      Int
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model MeetingRoom {
  id          String         @id @default(cuid())
  companyId   String
  name        String
  location    String?
  capacity    Int
  status      ResourceStatus @default(AVAILABLE)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([companyId])
  @@index([status])
}

/// Single reservation model for vehicles and rooms (resourceType discriminates).
model Reservation {
  id         String            @id @default(cuid())
  companyId  String
  userId     String
  directionId String?
  resourceType ResourceType
  vehicleId  String?
  roomId     String?
  startAt    DateTime
  endAt      DateTime
  destination    String?
  missionReason  String?
  passengerCount Int?
  meetingSubject   String?
  participantCount Int?
  comment          String?
  status           ReservationStatus @default(PENDING)
  rejectionReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  direction Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  room      MeetingRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([userId])
  @@index([directionId])
  @@index([vehicleId])
  @@index([roomId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([companyId, status, startAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// One Expo push token per device; a user may own several active devices.
model UserPushToken {
  id         String       @id @default(cuid())
  userId     String
  token      String       @unique
  platform   PushPlatform
  deviceName String?
  isActive   Boolean      @default(true)
  lastUsedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
