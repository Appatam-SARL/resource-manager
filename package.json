{
  "name": "resource-manager",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run start:dev",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "tsx prisma/dev-guard-cli.ts migrate-dev && prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "tsx prisma/dev-guard-cli.ts db-push && prisma db push --schema=prisma/schema.prisma",
    "db:reset": "tsx prisma/dev-guard-cli.ts migrate-reset && prisma migrate reset --schema=prisma/schema.prisma",
    "test:guards": "tsx --test prisma/dev-guard.spec.ts",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail=100",
    "stack:ps": "docker compose ps"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "turbo": "^2.11.3",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
